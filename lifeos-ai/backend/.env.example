DATABASE_URL=sqlite:///./lifeos.db
# Obligatoire en production (32 caractères minimum) : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-with-a-long-random-string
# open (dev) | first_user (usage perso : se ferme après le 1er compte) | closed
REGISTRATION_MODE=open
ANTHROPIC_API_KEY=
# Vide = modèle par défaut du code (app/ai/engine.py, DEFAULT_MODEL). Voir la doc Claude pour les noms à jour.
ANTHROPIC_MODEL=
# Fuseau des rappels quand le client n'en précise pas
DEFAULT_TIMEZONE=Europe/Paris

# Google Calendar (Phase 3) — voir README.md pour la procédure de création
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/google/callback
